{
  "version": 1,
  "ast_audit": true,
  "golden_arrow": {
    "enabled": true,
    "strict": false,
    "timeout_s": 360,
    "workers": 6
  },
  "deep_dive": {
    "enabled": true,
    "forensics": true,
    "web_search": true,
    "web_timeout_s": 20,
    "max_queries": 3
  },
  "fallback": {
    "on_error": "record-and-continue",
    "record": "logs/deep_dive.json"
  },
  "preflight": {
    "disk_floor_gb": 2.0
  },
  "retention": {
    "composite_eviction": false
  },
  "hyper_edge": {
    "reading_audit": true,
    "settings_shadow": true,
    "leg_ledger": true,
    "head_audit": true,
    "truncation": true,
    "strict": false,
    "leg_timeout_s": 300
  },
  "reading_audit": {
    "min_coverage": 0.0
  },
  "head_audit": {
    "max_state_age_days": 0
  },
  "settings_shadow": {
    "readers": [
      "read_default",
      "setting",
      "get_default"
    ]
  },
  "arena": {
    "endpoint": "http://127.0.0.1:8081",
    "quote_chars": 320,
    "max_tokens": 300,
    "workers": 6,
    "quorum": 0.66,
    "timeout_s": 120
  }
}
