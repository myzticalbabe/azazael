# =============================================================================
# Azazael Docker - Environment Variables (CD5 Split WAL Configuration)
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp docker/.env.example docker/.env
#
# Source: research/CROSS_DOMAIN.md sec.CD5 (June 11, 2026)
# =============================================================================

# ---------------------------------------------------------------------------
# CD5: Split WAL Configuration
# ---------------------------------------------------------------------------
# AZAZAEL_MEMORY_DIR: Persistent storage path for the main .db file.
#   In Docker, this points to a Docker volume mounted at /persistent.
#   Outside Docker, this can be any directory with persistent storage.
#   Default: /persistent (Docker volume)
AZAZAEL_MEMORY_DIR=/persistent

# AZAZAEL_WAL_DIR: tmpfs (RAM) storage path for SQLite WAL (-wal) and
#   shared memory (-shm) files. These are ephemeral and recoverable
#   from the main .db via WAL checkpoint.
#   In Docker, this points to a tmpfs mount at /data.
#   Outside Docker, this can be any tmpfs mount or fast storage.
#   Default: /data (tmpfs, 256MB limit)
AZAZAEL_WAL_DIR=/data

# ---------------------------------------------------------------------------
# Python Configuration
# ---------------------------------------------------------------------------
# PYTHON_GIL=0 enables free-threading mode (Python 3.14t).
# Required for concurrent WAL writes from multiple threads.
PYTHON_GIL=0

# PYTHONPATH must include the Azazael source directory.
PYTHONPATH=/app/azazael/src

# ---------------------------------------------------------------------------
# Application Paths
# ---------------------------------------------------------------------------
# AZAZAEL_WORKSPACE: Root workspace path for the Azazael project.
AZAZAEL_WORKSPACE=/app

# AZAZAEL_OUTPUT_PATH: Where generated files (reports, benchmarks) are written.
AZAZAEL_OUTPUT_PATH=/app/output

# ---------------------------------------------------------------------------
# Docker Volume Path (Host-side)
# ---------------------------------------------------------------------------
# AZAZAEL_DB_VOLUME_PATH: Host filesystem path for the persistent Docker volume.
#   When empty, Docker creates a managed volume in /var/lib/docker/volumes/.
#   When set, Docker binds to the specified directory.
#   Example: C:\azazael\data\db (Windows) or /data/azazael/db (Linux)
#   Default: ./data/db (relative to docker-compose.yml)
AZAZAEL_DB_VOLUME_PATH=./data/db

# ---------------------------------------------------------------------------
# Benchmark Configuration
# ---------------------------------------------------------------------------
# BENCHMARK_INSERTS: Number of SQLite inserts per benchmark run (default: 10000)
BENCHMARK_INSERTS=10000

# BENCHMARK_OUTPUT: Path for benchmark results JSON output.
BENCHMARK_OUTPUT=/app/output/benchmark_results.json
