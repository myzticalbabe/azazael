_eca_*.json

# Runtime evolution state — LIVE, mutated every 5 min by evolution_cycle.py.
# These must never be tracked: a git restore/checkout reverts them, which on
# 2026-09-10 silently bypassed the streak/holdout/promote/canary gates in
# reverse (production genes reverted 29.67 -> 28.23 with no promotion event).
# See EVOLUTION_PROCESS_AUDIT_20260910.md (D-1) / improvement item EV-1.
config/evolved_rl_params.json
config/evolved_rl_params.json.*
config/evolved_meta_params.json
state/evolved_rl_params.json
state/evolved_rl_params.json.*
state/evolution_pool_snapshot.json
state/evolution_pool_snapshot.json.tmp
state/holdout_cooldown.json
state/qd_archive.json
state/qd_archive.json.tmp
state/worm_policy.json
state/worm_policy.json.tmp
session_log*.txt
nul

# Gray Queen entrenchment baseline — LIVE runtime state, rewritten every spine
# cycle by SpineCycleWorm._governance_stage(). The DELTA it produces is the
# whole point, so a git checkout that reverted it would report a false
# "everything is new" entrenchment spike. (Its sibling
# NEURAL_MESH_WIRE_OR_CUT.json IS tracked: that one is a reviewed declaration
# table, not telemetry.)
NEURAL_MESH_ENTRENCHMENT.json
NEURAL_MESH_ENTRENCHMENT.json.tmp

# Regenerable render output (2026-09-28): animation frames and rendered
# monitor wallboards are rebuilt by their jobs (graphify/render). Tracking
# 3,150 PPMs + wallboards meant every render dirtied the tree, so they were
# untracked (files stay on disk). dashboard/index.html stays tracked.
output/ecosystem_frames/
output/matrix_frames/
dashboard/monitor_azazael.html
dashboard/monitor_exmachina.html
dashboard/monitor_lilith.html
dashboard/monitor_ml.html
dashboard/monitor_rl.html
dashboard/command_center.html
dashboard/command_center.json
