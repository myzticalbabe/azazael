@echo off
REM Azazael - Create Standalone Python Environment
REM Run as Administrator

echo ========================================
echo   Azazael - Standalone Python Environment
echo ========================================
echo.

set AZAAZEL_ROOT=C:\Users\clint\Desktop\Azazael_UNIFIED
set VENV_DIR=%AZAAZEL_ROOT%\.venv
set PYTHON_EXE=

echo [STEP 1] Finding Python 3.11...
echo.

REM Check for existing Python 3.11 installations
if exist "C:\Users\clint\.local\bin\python3.11.exe" (
    set PYTHON_EXE=C:\Users\clint\.local\bin\python3.11.exe
    echo [FOUND] Python 3.11 at: %PYTHON_EXE%
) else if exist "C:\Users\clint\AppData\Local\Programs\Python\Python311\python.exe" (
    set PYTHON_EXE=C:\Users\clint\AppData\Local\Programs\Python\Python311\python.exe
    echo [FOUND] Python 3.11 at: %PYTHON_EXE%
) else if exist "C:\Python311\python.exe" (
    set PYTHON_EXE=C:\Python311\python.exe
    echo [FOUND] Python 3.11 at: %PYTHON_EXE%
) else if exist "C:\Program Files\Python311\python.exe" (
    set PYTHON_EXE=C:\Program Files\Python311\python.exe
    echo [FOUND] Python 3.11 at: %PYTHON_EXE%
) else (
    echo [NOT FOUND] Python 3.11 not found
    echo.
    echo Installing Python 3.11 via winget...
    winget install Python.Python.3.11 --silent
    timeout /t 30 /nobreak >nul
    
    if exist "C:\Users\clint\AppData\Local\Programs\Python\Python311\python.exe" (
        set PYTHON_EXE=C:\Users\clint\AppData\Local\Programs\Python\Python311\python.exe
        echo [INSTALLED] Python 3.11 at: %PYTHON_EXE%
    ) else (
        echo [ERROR] Python installation failed
        goto :END
    )
)

echo.
%PYTHON_EXE% --version

echo.
echo [STEP 2] Creating virtual environment...

if exist "%VENV_DIR%" (
    echo Removing old environment...
    rmdir /s /q "%VENV_DIR%" 2>nul
)

echo Creating new venv at: %VENV_DIR%
%PYTHON_EXE% -m venv "%VENV_DIR%"

if exist "%VENV_DIR%\Scripts\python.exe" (
    echo [OK] Virtual environment created
) else (
    echo [ERROR] Failed to create venv
    goto :END
)

echo.
echo [STEP 3] Upgrading pip...
"%VENV_DIR%\Scripts\pip.exe" install --upgrade pip >nul 2>&1
echo [OK] Pip upgraded

echo.
echo [STEP 4] Installing core packages...
echo (numpy, scipy, pandas, sklearn, matplotlib, seaborn, jupyter)
"%VENV_DIR%\Scripts\pip.exe" install numpy>=1.24.0 scipy>=1.10.0 pandas>=2.0.0 scikit-learn>=1.3.0 matplotlib>=3.7.0 seaborn>=0.12.0 jupyter>=1.0.0 ipython>=8.0.0 >nul 2>&1
echo [OK] Core packages installed

echo.
echo [STEP 5] Installing ML frameworks...
echo (torch, tensorflow, jax, transformers, datasets, accelerate, onnx, xgboost, lightgbm)
"%VENV_DIR%\Scripts\pip.exe" install torch>=2.0.0 torchvision>=0.15.0 torchaudio>=2.0.0 tensorflow>=2.13.0 jax>=0.4.0 jaxlib>=0.4.0 transformers>=4.30.0 datasets>=2.14.0 accelerate>=0.20.0 onnx>=1.14.0 onnxruntime>=1.15.0 xgboost>=2.0.0 lightgbm>=4.0.0 optuna>=3.3.0 mlflow>=2.7.0 ray[default]>=2.6.0 >nul 2>&1
echo [OK] ML frameworks installed

echo.
echo [STEP 6] Testing imports...

set PASSED=0
set FAILED=0

for %%m in (numpy scipy pandas sklearn torch tensorflow jax transformers) do (
    for /f "tokens=*" %%v in ('"%VENV_DIR%\Scripts\python.exe" -c "import %%m; print(%%m.__version__)" 2^>nul') do (
        echo [OK] %%m: %%v
        set /a PASSED+=1
    )
    if errorlevel 1 (
        echo [--] %%m: not available
        set /a FAILED+=1
    )
)

echo.
echo [STEP 7] Creating environment files...

echo # Generated by install_python_env.bat > "%VENV_DIR%\pyvenv.cfg"
echo home = %PYTHON_EXE% >> "%VENV_DIR%\pyvenv.cfg"
echo include-system-site-packages = false >> "%VENV_DIR%\pyvenv.cfg"
echo version = 3.11.0 >> "%VENV_DIR%\pyvenv.cfg"

"%VENV_DIR%\Scripts\pip.exe" freeze > "%VENV_DIR%\requirements.txt"

echo [OK] Environment files created

echo.
echo ========================================
echo   Environment Setup Complete!
echo ========================================
echo.
echo Location: %VENV_DIR%
echo Python: 3.11.x
echo Tests: %PASSED% passed, %FAILED% failed
echo.
echo To use HYDRA:
echo   "%VENV_DIR%\Scripts\python.exe" harness.py status
echo.
echo Or activate environment:
echo   "%VENV_DIR%\Scripts\activate.bat"

:END
echo.
pause
