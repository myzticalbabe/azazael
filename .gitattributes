# The Soul Forge License text is compared byte-for-byte against a canonical
# copy by tools/soul_license_audit.py and tests/test_soul_license_only.py.
# With core.autocrlf=true a checkout rewrites every line as CRLF, which made
# that comparison fail for all 38 trees in a fresh clone while passing in the
# working tree the files were written in. Pin the licence files to LF so the
# checked-out bytes are the canonical bytes on every platform.
LICENSE text eol=lf

# The METTHEW reference shards are bundles: each shard.json declares the sha256
# and size_bytes of main.py and SHARD.md, and tools/metthew_validate.py compares
# the file on disk with that declaration. With core.autocrlf=true a checkout
# rewrites both as CRLF (one byte per line larger), so every bundle was refused
# for bytes its manifest never declared while the committed blobs were correct.
# Pin the shard tree to LF so the checked-out bytes are the declared bytes.
docs/METTHEW/reference-shards/** text eol=lf
