#!/bin/sh
# Pre-commit hook: compliance scanner + anti-pattern ratchet on staged .py files
# Installed by: python tools/install_git_hooks.py  (sets core.hooksPath=.githooks)
#
# Check order (cheap-and-broad first, so a bad commit is rejected early):
#   1. bulk-diff focus gate      (scripts/commit_gate.py)
#   7b. testing-paradigm G1     (tools/test_paradigm_gate.py, blocking)
#   1b. stale-index guard        (tools/index_drift_check.py) -- a path staged
#       and then edited again would be committed as the STALE blob, and the
#       scanner below reads the INDEX, so it would certify a version that is
#       not on disk at all
#   2. staged NEW anti-pattern  (tools/staged_scanner_gate.py, per-file vs HEAD)
#   3. canon drift check         (tools/canon_drift_check.py --check)
#   4. repo-wide anti-pattern ratchet (tools/anti_pattern_gate.py --check)
#   9. unified gate registry     (tools/preflight_all.py --check, blocking;
#       runs after the hand-written gates, see its stanza below)
#  10. generated instruction blocks (tools/agent_orders_sync.py --check,
#       blocking) -- the rule files this session READS are generated from one
#       source; a commit must not land while a copy disagrees with it
#
# Why check 3 exists even though check 2 already scans: check 2 is PER-FILE
# (staged vs HEAD), so it catches an anti-pattern being ADDED but cannot see
# the running total. The ratchet compares the whole
# `src/` tree against logs/anti_pattern_baseline.json and fails on any
# category INCREASE, which is what keeps the 2,224-finding backlog from
# growing while it is paid down (reports/ERROR_LESSON_AUDIT_2026-10-03.md,
# gap 1: "MECHANIZED BUT NOT ENFORCED").
#
# Check 3 runs on EVERY commit, including commits with no staged .py files:
# check 2 skips in that case, and it is exactly the docs/data commit that
# could still have grown the tree. A check that is skipped when it is
# inconvenient is the defect this hook exists to stop.

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR" || exit 1

# 3.15t production interpreter (python3 previously resolved to 3.13.14
# WindowsApps — a fourth interpreter). Pin here so every gate runs on 3.15t.
PYTHON3="C:/Azazael/.venvs/py315t/Scripts/python.exe"
# Every gate below runs on $PY, never on a bare `python`: the unpinned name
# resolved to 3.13.14 from WindowsApps on this box. 3.14t is retired
# (2026-10-19); the ladder only reaches py314m when no 3.15 interpreter exists.
PY="$PYTHON3"
if [ ! -x "$PY" ]; then
    for cand in "C:/Azazael/.venvs/py315/Scripts/python.exe" \
                "C:/Azazael/.venvs/py314m/Scripts/python.exe" \
                "$(command -v python3.15t 2>/dev/null)" \
                "$(command -v python3 2>/dev/null)"; do
        [ -n "$cand" ] && [ -x "$cand" ] && { PY="$cand"; break; }
    done
fi

# ─── Check 1: bulk-diff focus gate ───
# Runs FIRST, on every commit, because the scanner below skips when no .py
# files are staged -- and bulk dirt is usually docs/data, not code. Focused
# commits pass; deliberate bulk ops declare ALLOW_BULK_COMMIT=1.
echo "[Gate] Checking changeset focus..."
if [ -x "$PYTHON3" ]; then
    "$PYTHON3" scripts/commit_gate.py --hook 2>&1
    if [ $? -ne 0 ]; then
        echo ""
        echo "[Gate] Bulk changeset blocked (see above)."
        exit 1
    fi
    echo "[Gate] Changeset is focused."
else
    echo "[Gate] 3.15t python not found -- passing loud (gate unrunnable)"
fi
echo ""

# ─── Check 1b: stale-index guard ───
# Runs BEFORE the scanner, because the scanner reads the INDEX
# (`git show :0:<path>`): with a stale index it certifies a version nobody has
# on disk -- and that version is what would be COMMITTED. Measured 2026-10-11:
# a commit rejected by the scanner was then corrected in the worktree and
# re-committed without `git add`, so HEAD recorded the opposite of the truth.
# The tell was a staged diff of 68 insertions(+) and 0 DELETIONS for an edit
# that removed words -- a shape nobody reads at the moment it happens.
echo "[IndexDrift] Checking that every staged path matches the worktree..."
if [ -f "$SCRIPT_DIR/tools/index_drift_check.py" ]; then
    # Capture first, then print: `cmd | tail` would make $? tail's status, not
    # the check's, and a gate that reads the wrong exit code is worse than none.
    DRIFT_OUT=$("$PY" "$SCRIPT_DIR/tools/index_drift_check.py" 2>&1)
    DRIFT_EXIT=$?
    echo "$DRIFT_OUT" | tail -12
    if [ $DRIFT_EXIT -ne 0 ]; then
        echo ""
        echo "[IndexDrift] A staged path has unstaged edits: the commit would"
        echo "[IndexDrift] carry the version from before that edit."
        echo "[IndexDrift] Fix: git add <path>   (or declare ALLOW_STALE_INDEX=1)"
        exit 1
    fi
else
    echo "[IndexDrift] guard not found -- passing loud (guard unrunnable)"
fi
echo ""

# ─── Check 2: compliance scanner on the staged .py snapshot ───
# Diffs each staged .py file against its HEAD version and fails only on a
# per-category INCREASE. The old form wrote a temp snapshot and failed on ANY
# finding at --severity warning, so every legacy file (837 silent_except_pass
# in the baseline) was uncommittable -- a gate that can never pass is the same
# defect class as one that can never fail.
echo "[Scanner] Checking staged .py files for NEW anti-patterns..."
if [ -f "$SCRIPT_DIR/tools/staged_scanner_gate.py" ]; then
    PYTHONPATH="src:${PYTHONPATH:-}" "$PY" "$SCRIPT_DIR/tools/staged_scanner_gate.py" 2>&1
    SCAN_EXIT=$?
    if [ $SCAN_EXIT -ne 0 ]; then
        echo ""
        echo "[Scanner] New anti-pattern(s) in staged .py files."
        exit 1
    fi
else
    echo "[Scanner] gate not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 3: canon drift (source corpus vs load path) ───
# `skills/` is the source corpus (RULE 0R); `.agents/skills/<n>/SKILL.md` is
# what `skill()` loads. Nothing checked that sync happened, and 44 skills had
# drifted -- 26 with the load-path copy missing its YAML frontmatter entirely.
echo "[Canon] Checking skill corpus against the load path..."
if [ -f "$SCRIPT_DIR/tools/canon_drift_check.py" ]; then
    # Capture first, then print: `cmd | tail` would make $? tail's status, not
    # the check's, and a gate that reads the wrong exit code is worse than none.
    CANON_OUT=$("$PY" "$SCRIPT_DIR/tools/canon_drift_check.py" --check 2>&1)
    CANON_EXIT=$?
    echo "$CANON_OUT" | tail -12
    if [ $CANON_EXIT -ne 0 ]; then
        echo ""
        echo "[Canon] Skill drift between skills/ and .agents/skills/."
        echo "[Canon] Reconcile: python tools/canon_drift_check.py --fix"
        exit 1
    fi
else
    echo "[Canon] check not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 4: repo-wide anti-pattern ratchet ───
# Fails on any category COUNT increase over the recorded baseline. This runs
# unconditionally: the scanner snapshot in check 2 cannot see the running total,
# and the backlog is what is ratcheted.
#
# --tracked-only (added 2026-11-01): the tree-wide scan counts UNTRACKED files,
# so on 2026-11-01 three `??` modules created by another lane (CODEX/
# dit_video_pipeline.py, CORE/feast_feature_store.py, CORE/
# langgraph_integration.py) added 6 import_inside_function and 1
# except_return_default and blocked a PSYCHE commit that contained none of them.
# The gate's own --tracked-only help names this case: "gating a commit on the
# desk drawer blocks reviewed changesets for files no commit contains." Staged
# additions are still counted, because `git ls-files` reads the INDEX, so new
# code is measured the moment it is added -- and the untracked files will be
# counted at the commit that first tracks them, which is the ratchet working as
# designed rather than as noise.
echo "[Ratchet] Comparing anti-pattern counts against baseline (tracked files)..."
if [ -f "$SCRIPT_DIR/tools/anti_pattern_gate.py" ]; then
    PYTHONPATH="src:${PYTHONPATH:-}" "$PY" "$SCRIPT_DIR/tools/anti_pattern_gate.py" --check --tracked-only 2>&1
    RATCHET_EXIT=$?
    if [ $RATCHET_EXIT -ne 0 ]; then
        echo ""
        echo "[Ratchet] Anti-pattern count INCREASED over baseline. Fix the new"
        echo "[Ratchet] finding(s), or -- for a reviewed, deliberate increase --"
        echo "[Ratchet] re-run: python tools/anti_pattern_gate.py --baseline"
        exit 1
    fi
else
    echo "[Ratchet] gate not found -- passing loud (gate unrunnable)"
fi
echo ""

# ─── Check 4b: unresolved cross-language references (ratchet) ───
# The census can only place what it can resolve. On 2026-10-31 that was 110 of
# 142 driver references, and the 32 leftovers lived in a JSON file nobody
# re-reads -- so the next session inherited 32 by default rather than by
# decision, and the 33rd would arrive unremarked. Same ratchet semantics as the
# anti-pattern baseline above: the count may fall, never rise. Shell-only on
# purpose: the js extractor is tree-sitter-or-regex depending on the
# interpreter, and a gate that flips between two pythons is useless.
echo "[Refs] Comparing unresolved cross-language references against baseline..."
if [ -f "$SCRIPT_DIR/tools/unresolved_ratchet.py" ]; then
    UNRES_OUT=$("$PY" "$SCRIPT_DIR/tools/unresolved_ratchet.py" --check 2>&1)
    UNRES_EXIT=$?
    echo "$UNRES_OUT" | tail -12
    if [ $UNRES_EXIT -ne 0 ]; then
        echo ""
        echo "[Refs] A reference the census cannot place was added."
        echo "[Refs] Resolve it, declare it in tools/resolution_aliases.json, or --"
        echo "[Refs] for a reviewed, deliberate increase -- re-run:"
        echo "[Refs]   python tools/unresolved_ratchet.py --baseline"
        exit 1
    fi
else
    echo "[Refs] gate not found -- passing loud (gate unrunnable)"
fi
echo ""

# ─── Check 4c: the canon corpus cites itself honestly ───
# docs/bible/bible.json is prose that makes claims about this repository: every
# citation must resolve, every figure must name the command that produced it, and
# every statute must name both the RULE it comes from and the check that executes
# it. A canon that contradicts itself is worse than no canon, because it is
# quotable -- so the corpus is data and this is the apparatus. Absent corpus is
# "passing loud", the same as a missing gate: the check cannot judge what is not
# there, and pretending otherwise would make an empty file look clean.
echo "[Bible] Checking that the canon corpus resolves its own citations..."
if [ -f "$SCRIPT_DIR/tools/bible_check.py" ]; then
    BIBLE_OUT=$("$PY" "$SCRIPT_DIR/tools/bible_check.py" --check 2>&1)
    BIBLE_EXIT=$?
    echo "$BIBLE_OUT" | tail -20
    if [ $BIBLE_EXIT -ne 0 ]; then
        echo ""
        echo "[Bible] BLOCKED: the corpus contradicts itself (see above)."
        echo "[Bible] Fix the citation, name the command behind the figure, or bind"
        echo "[Bible] the statute: python tools/bible_check.py --check"
        exit 1
    fi
else
    echo "[Bible] gate not found -- passing loud (gate unrunnable)"
fi
echo ""

# ─── Check 5: mesh wire-or-cut ledger freshness ───
# NEURAL_MESH_WIRE_OR_CUT.json is GENERATED, and nothing regenerated it when
# a caller changed -- so it went stale silently. Measured 2026-10-10: the
# restored EP235 loop made read_pressure statically called while the ledger
# still said `dispatched`, and tests/test_mesh_wire_or_cut.py failed on state
# the code had already moved past. Fails when the set of unreferenced
# functions no longer matches the committed ledger.
echo "[Mesh] Checking wire-or-cut ledger freshness..."
if [ -f "$SCRIPT_DIR/tools/mesh_function_preflight.py" ]; then
    # Capture first, then print: piping into tail would make $? tail's
    # status and this gate would read the wrong exit code.
    MESH_OUT=$(PYTHONPATH="src:${PYTHONPATH:-}" "$PY" "$SCRIPT_DIR/tools/mesh_function_preflight.py" --check 2>&1)
    MESH_EXIT=$?
    echo "$MESH_OUT" | tail -12
    if [ $MESH_EXIT -ne 0 ]; then
        echo ""
        echo "[Mesh] Ledger is STALE against the code. Refresh:"
        echo "[Mesh]   python tools/mesh_function_preflight.py --verdict --triage"
        exit 1
    fi
else
    echo "[Mesh] check not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 6: wire evidence on every `wired` declaration ───
# The mesh check above compares the ledger's KEY SET. It passed 2026-10-19
# while 136 of 137 `wired` rows carried `module-linked: no` in their own
# evidence: the status claimed a caller, and nothing in the pipeline asked for
# one. tools/wire_evidence_audit.py --check fails when a wired row carries
# neither `link_evidence` nor a named `link_gap`, so a new wired claim has to
# say where its support is. Regenerate the annotation with --apply.
echo "[Wire] Checking that wired declarations carry their link evidence..."
if [ -f "$SCRIPT_DIR/tools/wire_evidence_audit.py" ]; then
    # Same capture-then-print discipline as the mesh check: `| tail` would
    # replace the gate's exit status with tail's.
    WIRE_OUT=$(PYTHONPATH="src:${PYTHONPATH:-}" "$PY" "$SCRIPT_DIR/tools/wire_evidence_audit.py" --check 2>&1)
    WIRE_EXIT=$?
    echo "$WIRE_OUT" | tail -12
    if [ $WIRE_EXIT -ne 0 ]; then
        echo ""
        echo "[Wire] A wired declaration has no recorded link. Annotate:"
        echo "[Wire]   python tools/wire_evidence_audit.py --apply"
        exit 1
    fi
else
    echo "[Wire] check not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 6b (blocking): evidence gate (2026-10-30) ───
# Three failures this month had one shape: a statement true when written was
# repeated after the code moved, and nothing re-derived it -- a `rotate_secret`
# with no callers that returned success while writing nothing, an
# `enforce_global_quota` with no caller, and 135 `wired` ledger rows whose only
# support is a bare token in a file that does not import the module.
# tools/evidence_gate.py re-derives instead of reading prose: it parses every
# .py (an unparseable file is invisible to every other AST check), finds
# control-named functions with no module-linked caller, and asks the mesh probe
# whether its own ledger is fresh. Legacy debt is recorded in
# state/evidence_gate_baseline.json and does NOT fail; NEW debt does. A gate
# that fails on day one is a gate somebody disables.
# Deliberately NOT wired_claims: Check 6 above already gates wired-row link
# evidence through tools/wire_evidence_audit.py.
# Declared override, never silent: ALLOW_EVIDENCE_GATE=1.
if [ "${ALLOW_EVIDENCE_GATE:-}" = "1" ]; then
    echo "[Evidence] gate skipped: ALLOW_EVIDENCE_GATE=1 declared."
    echo ""
fi
if [ "${ALLOW_EVIDENCE_GATE:-}" != "1" ] && [ -f "$SCRIPT_DIR/tools/evidence_gate.py" ]; then
    echo "[Evidence] Re-deriving control and ledger claims from source..."
    # Capture first, then print: `cmd | tail` makes $? tail's status, and a gate
    # that reads the wrong exit code is worse than no gate (3 false passes).
    EVIDENCE_OUT=$(PYTHONPATH="src:${PYTHONPATH:-}" "$PY" "$SCRIPT_DIR/tools/evidence_gate.py" \
        --only ast_parse_coverage,dead_control,ledger_freshness 2>&1)
    EVIDENCE_EXIT=$?
    echo "$EVIDENCE_OUT" | tail -22
    if [ $EVIDENCE_EXIT -ne 0 ]; then
        echo ""
        echo "[Evidence] BLOCKED: a control or ledger claim no longer re-derives."
        echo "[Evidence] New debt above is not in state/evidence_gate_baseline.json."
        echo "[Evidence] Fix the code, or accept it explicitly:"
        echo "[Evidence]   python tools/evidence_gate.py --update-baseline"
        echo "[Evidence] Override (declared): ALLOW_EVIDENCE_GATE=1."
        exit 1
    fi
    echo ""
else
    echo "[Evidence] gate not found or skipped -- passing loud (check unrunnable)"
    echo ""
fi

# ─── Check 7b (blocking): testing-paradigm G1 (Engram #890 item 4) ───
# Every NEW staged src/ module must be named by at least one tests/ file.
# Narrow by design (Added-only, name-presence only) so it cannot
# false-positive on the existing tree; measured green on wiring day
# (modules=0 on the landing index). Blocking from birth: an advisory
# presence gate that never blocks is the #889 drift shape (mechanized
# but not enforced). Bypass only by naming the module in a test.
if [ -f "$SCRIPT_DIR/tools/test_paradigm_gate.py" ]; then
    if [ -x "$PYTHON3" ]; then
        "$PYTHON3" "$SCRIPT_DIR/tools/test_paradigm_gate.py" 2>&1
        if [ $? -ne 0 ]; then
            echo ""
            echo "[Paradigm] BLOCKED (G1). Name the new src/ module in a tests/ file."
            exit 1
        fi
    else
        echo "[Paradigm] 3.15t python not found -- passing loud (gate unrunnable)"
    fi
fi

# ─── Check: heredoc-pipe lint (advisory, shell files) ───
if [ -f "$SCRIPT_DIR/tools/heredoc_pipe_lint.py" ]; then
    staged_sh=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.(sh|bash)$' || true)
    if [ -n "$staged_sh" ]; then
        if [ -x "$PYTHON3" ]; then
            echo "$staged_sh" | xargs "$PYTHON3" "$SCRIPT_DIR/tools/heredoc_pipe_lint.py" >/dev/null 2>&1
            if [ $? -ne 0 ]; then
                echo "[HeredocLint] advisory: unsafe heredoc detected in staged shell file(s)"
            fi
        fi
    fi
fi

# ─── Check 8 (blocking): unified supervisor verdict ───
# The supervisor MCP merges the Engram gate with PMB liveness and honest PAMS
# probes. A commit on NO-GO would record a tree the memories say is broken,
# so this refuses -- but ONLY on a parsed NO-GO (positive evidence). GO and
# CLARIFY pass; an unrunnable/unparseable oracle passes loud (a gate that
# blocks when it cannot measure is a denial-of-service on every commit).
# Deliberate override, declared not silent: ALLOW_SUPERVISOR_NOGO=1.
# Remediation pointer, not just refusal: tools/supervisor_doctor.py --fix.
if [ "${ALLOW_SUPERVISOR_NOGO:-}" = "1" ]; then
    echo "[Supervisor] NO-GO override declared via ALLOW_SUPERVISOR_NOGO=1."
    echo ""
fi
if [ "${ALLOW_SUPERVISOR_NOGO:-}" != "1" ] && [ -f "$SCRIPT_DIR/tools/supervisor_mcp.py" ]; then
    echo "[Supervisor] Checking unified verdict..."
    if [ -x "$PYTHON3" ]; then
        SUP_OUT=$("$PYTHON3" "$SCRIPT_DIR/tools/supervisor_mcp.py" --verdict 2>&1)
        SUP_EXIT=$?
        echo "$SUP_OUT" | tail -10
        SUP_VERDICT=$(echo "$SUP_OUT" | grep "^VERDICT:" | tail -1)
        case "$SUP_VERDICT" in
            *NO-GO*)
                echo ""
                echo "[Supervisor] BLOCKED: memories report NO-GO (see above)."
                echo "[Supervisor] Remediate: judge pending pairs, record outcomes,"
                echo "[Supervisor]   then: python tools/supervisor_doctor.py --fix"
                echo "[Supervisor] Override (declared): ALLOW_SUPERVISOR_NOGO=1."
                exit 1
                ;;
            *)
                if [ -z "$SUP_VERDICT" ]; then
                    echo "[Supervisor] verdict unparseable (exit=$SUP_EXIT) -- passing loud."
                fi
                ;;
        esac
    else
        echo "[Supervisor] 3.15t python not found -- passing loud (gate unrunnable)"
    fi
    echo ""
fi

# ─── Check 7 (advisory): testing-paradigm rule 1 (Engram #784) ───
# A new src/ function needs a staged Hypothesis property test. Advisory by
# default: a presence heuristic must not block commits until it is measured.
# Set PARADIGM_GATE_STRICT=1 to make it blocking. Its exit code is printed,
# not enforced, unless strict mode is on.
if [ -f "$SCRIPT_DIR/tools/paradigm_gate.py" ]; then
    PARADIGM_OUT=$("$PY" "$SCRIPT_DIR/tools/paradigm_gate.py" --check 2>&1)
    PARADIGM_EXIT=$?
    echo "$PARADIGM_OUT"
    if [ $PARADIGM_EXIT -ne 0 ]; then
        echo "[Paradigm] BLOCKED (strict mode). Stage a Hypothesis property test."
        exit 1
    fi
fi

# ─── Check 10 (blocking): generated instruction blocks vs their source ───
# The MCP gate standing order, the FLOCK canon and the META-LEVELS canon are
# single-sourced in `docs/agent_orders/*.md` and GENERATED into nine instruction
# files (home `AGENTS.md`, `C:/Azazael/AGENTS.md`, and the kilo / opencode /
# claude lane files). Until 2026-10-30 those blocks had four hand-maintained
# copies; the gate they described was rewritten the same day and every copy was
# stale within hours, so each session opened on instructions describing a check
# that no longer existed. A commit is where the source changes, so a commit is
# where the copies must still match it.
# Runs on EVERY commit, including commits that touch no rule file: the targets
# live OUTSIDE the repo, so a staged-path filter could never see the drift this
# check exists to stop.
# Declared override, never silent: ALLOW_AGENT_ORDERS_DRIFT=1.
if [ "${ALLOW_AGENT_ORDERS_DRIFT:-}" = "1" ]; then
    echo "[AgentOrders] skipped: ALLOW_AGENT_ORDERS_DRIFT=1 declared."
    echo ""
fi
if [ "${ALLOW_AGENT_ORDERS_DRIFT:-}" != "1" ] && [ -f "$SCRIPT_DIR/tools/agent_orders_sync.py" ]; then
    echo "[AgentOrders] Checking generated instruction blocks against their source..."
    # Status captured immediately, output printed after. `cmd | tail` makes $?
    # tail's status, not the check's -- a false pass this repo has produced
    # three times.
    #           --hook: compare only the targets that EXIST on this host, print
    #           the ones that do not, and fail if none exist at all. The nine
    #           targets are host-absolute lane files, so a Kali lane or a fresh
    #           clone would otherwise block every commit over files it cannot
    #           see -- a gate that cannot run here is worse than no gate.
    #           --wsl: the Ubuntu and Kali lanes read their orders from the
    #           Linux tree, and on 2026-10-31 NEITHER carried a single block
    #           (Ubuntu /root/AGENTS.md 2003 bytes / 0 blocks; Kali
    #           /root/BCC-REINVESTIGATION/AGENTS.md 14783 / 0). Those blocks are
    #           host-rewritten (python -> python3, C:/ -> /mnt/c), so they can
    #           never be checked by looking at Windows files. A host without wsl
    #           says so and passes; a present distro that drifts blocks.
    #           3.6 s measured, so it rides along instead of being a separate gate.
    ORDERS_OUT=$("$PY" "$SCRIPT_DIR/tools/agent_orders_sync.py" --hook --wsl 2>&1)
    ORDERS_EXIT=$?
    echo "$ORDERS_OUT"
    if [ $ORDERS_EXIT -ne 0 ]; then
        echo ""
        echo "[AgentOrders] BLOCKED: a generated block differs from azazael/docs/agent_orders/."
        echo "[AgentOrders] Fix: $PY $SCRIPT_DIR/tools/agent_orders_sync.py --apply --wsl"
        echo "[AgentOrders] Copies are never hand-edited -- edit the source, then regenerate."
        echo "[AgentOrders] Override (declared): ALLOW_AGENT_ORDERS_DRIFT=1."
        exit 1
    fi
    echo ""
fi

# ─── Check 9 (blocking): unified gate registry (tools/preflight_all.py) ───
# The gate set above is hand-listed: a gate is enforced only if somebody
# remembers to add a stanza to this file. tools/preflight_all.py holds the
# registry (gate, artifact, control test) in one tracked runner, so the commit
# path can ask the registry instead of a copy of it. It runs LAST among the
# blocking checks because it re-runs several of them; it is the backstop for
# whatever the hand-written list does not name.
# MEASURED? NO. The per-commit latency of `--check` has NOT been measured by
# the author of this stanza. Its placement is not a claim that it is cheap, and
# that measurement is owed before this scope is tightened further.
# --include-slow is deliberately NOT passed: commit latency stays at default.
# Declared override, never silent: ALLOW_PREFLIGHT=1.
if [ "${ALLOW_PREFLIGHT:-}" = "1" ]; then
    echo "[Preflight] gate registry skipped: ALLOW_PREFLIGHT=1 declared."
    echo ""
fi
if [ "${ALLOW_PREFLIGHT:-}" != "1" ]; then
    if [ -f "$SCRIPT_DIR/tools/preflight_all.py" ]; then
        if [ -x "$PYTHON3" ]; then
            echo "[Preflight] Checking unified gate registry..."
            # Status captured immediately. The gate's own output is NOT piped
            # through head/tail before $? is read: that pipeline rc trap has
            # produced a false pass in this repo three times.
            PREFLIGHT_OUT=$("$PYTHON3" "$SCRIPT_DIR/tools/preflight_all.py" --check 2>&1)
            PREFLIGHT_EXIT=$?
            echo "$PREFLIGHT_OUT"
            if [ $PREFLIGHT_EXIT -ne 0 ]; then
                echo ""
                echo "[Preflight] BLOCKED: gate registry reported failures (see above)."
                echo "[Preflight] Override (declared): ALLOW_PREFLIGHT=1."
                exit 1
            fi
            echo ""
        else
            echo "[Preflight] 3.15t python not found -- passing loud (gate unrunnable)"
            echo ""
        fi
    else
        echo "[Preflight] tools/preflight_all.py absent -- passing loud (registry unrunnable)"
        echo ""
    fi
fi

# NOTE: the RULE 0B-E commit-message claim guard lives in
# .githooks/prepare-commit-msg, NOT here. It was first written into this file
# and MEASURED BROKEN: `git commit -m` writes .git/COMMIT_EDITMSG *after*
# pre-commit runs, so the check read a stale file, passed, and an overclaiming
# message ("this is done, nothing was modified, this passes") landed as
# 94970d9e before the fault was found. prepare-commit-msg receives the message
# file as $1 and runs BEFORE this hook, so it sees the real text. A guard that
# reads the wrong file is worse than no guard -- it manufactures false
# confidence, which is the exact defect class RULE 0B-E exists to stop.

# ─── Check 6 (non-blocking): PMB outcome observer ───
# A commit is an outcome-bearing turn. Recording it here feeds PMB's
# Earned-Memory loop (`lesson_impact`) and its adherence pass, both of which
# read the `agent_actions` table. That table is written on this host by
# tools/pmb_session_observe.py, wired at the two triggers that ALWAYS fire --
# the test run (conftest.py) and this commit. Deliberately NON-blocking: a
# memory side-effect must never reject a commit, so its exit code is ignored.
if [ -f "$SCRIPT_DIR/tools/pmb_session_observe.py" ]; then
    PMB_PY="${PMB_VENV_PYTHON:-$HOME/.pmb-venv/Scripts/python.exe}"
    if [ -x "$PMB_PY" ]; then
        "$PMB_PY" "$SCRIPT_DIR/tools/pmb_session_observe.py" --commit-ok --quiet 2>/dev/null || true
    fi
fi

# ─── Advisory: transcript AP-5 gate (Engram #1012) ───
# Scans persisted assistant prose for permission-seeking language (AP-5).
# Fail-open: a missing/locked store or any error never blocks the commit.
# Report only — adjudication is human. Runs on 3.15t (pinned above).
if [ -f "$SCRIPT_DIR/tools/transcript_ap5_gate.py" ]; then
    echo "[AP5] Scanning persisted assistant prose..."
    "$PYTHON3" "$SCRIPT_DIR/tools/transcript_ap5_gate.py" --limit 500 2>&1 || true
    echo ""
fi

exit 0
