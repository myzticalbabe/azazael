#!/bin/sh
# Pre-commit hook -- TIER: FAST. Holds the commit on what the commit IS.
# Installed by: python tools/install_git_hooks.py  (sets core.hooksPath=.githooks)
#
# TWO TIERS, ONE GATE SET (split measured 2026-11-02)
# ---------------------------------------------------
# The hook had grown to 790 lines and 26 checks, and one run cost 182.2 s on this
# machine (measured: `sh .githooks/pre-commit` against a one-file staged index,
# exit 0). That number is why the set is split, and the split is by QUESTION,
# not by cost:
#
#   FAST (here) -- what this commit IS. Its changeset shape, its staged blobs,
#     the findings in them, and the instruction files it ships. These depend on
#     the index, so they can be true now and false ten minutes later; a commit
#     is the only moment where they are still about the thing being committed.
#
#   EVIDENCE (pre-push, or `COMMIT_TIER=full` here) -- what the TREE IS. Whole-
#     tree re-derivations: anti-pattern and reference ratchets, the canon
#     corpora, the platform claims, the mesh/wire/evidence ledgers, the gate
#     registry. Their answer cannot change between two commits and does not
#     depend on this commit's paths, so re-deriving them per commit bought
#     nothing and cost the author three minutes per attempt.
#
# They are NOT deleted and NOT relaxed: tools/evidence_tier.sh holds them, and
# the push hook (.githooks/pre-push, generated from tools/bible_ship.PRE_PUSH)
# runs that identical file before anything leaves the machine, with the same
# refusals and the same declared overrides. A check that stopped running would be
# the defect this hook exists to stop; a check that runs at PUSH instead of at
# COMMIT is a decision about timing, and this header is where the decision is
# visible. Every commit prints which tier it ran and what the evidence tier last
# said.
#
# The tier file lives in tools/ ON PURPOSE. It was first written into
# `.githooks/lib/`, which `.gitignore`'s `.githooks/*` rule excludes -- so the
# gate ran on this host only, while the push hook that calls it is generated on
# every clone. A hook that calls an untracked script is installed-looking and
# refuses nothing.
#
# FAST tier checks, in order:
#   0.   disk floor                   (tools/disk_floor_gate.py) -- a full disk
#        fails as a locked database or corrupt object, not as "disk full"
#   1.   bulk-diff focus gate         (scripts/commit_gate.py)
#   1b.  stale-index guard            (tools/index_drift_check.py) -- the staged
#        scanner reads the INDEX, so with a stale index it certifies a version
#        nobody has on disk, and that version is what would be committed
#   2.   staged NEW anti-patterns     (tools/staged_scanner_gate.py)
#   3.   canon drift                  (tools/canon_drift_check.py --check)
#   7b.  testing-paradigm G1          (tools/test_paradigm_gate.py)
#   10.  generated instruction blocks (tools/agent_orders_sync.py --hook --wsl)
#   10b. instruction-file PROSE       (tools/prompt_check.py)
#   8.   unified supervisor verdict   (tools/supervisor_mcp.py --verdict)
#
# Checks 10 and 10b stay in FAST even though they read files outside the repo:
# those nine lane files are not part of any staged path, so a commit is the only
# moment where "the copies I just read are the copies I am shipping" can be
# asked at all. Neither is expensive (prompt_check does no subprocesses).
#
# Declared overrides, unchanged and never silent: ALLOW_BULK_COMMIT=1,
# ALLOW_STALE_INDEX=1, ALLOW_AGENT_ORDERS_DRIFT=1, ALLOW_PROMPT_STALE=1,
# ALLOW_SUPERVISOR_NOGO=1, and COMMIT_TIER=full to run the evidence tier inline.

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR" || exit 1

# 3.15t production interpreter (python3 previously resolved to 3.13.14
# WindowsApps — a fourth interpreter). Pin here so every gate runs on 3.15t.
PYTHON3="C:/Azazael/.venvs/py315t/Scripts/python.exe"
# Every gate below runs on $PY, never on a bare `python`: the unpinned name
# resolved to 3.13.14 from WindowsApps on this box. 3.14t is retired
# (2026-10-19); the ladder only reaches py314m when no 3.15 interpreter exists.
PY="$PYTHON3"
if [ ! -x "$PY" ]; then
    for cand in "C:/Azazael/.venvs/py315/Scripts/python.exe" \
                "C:/Azazael/.venvs/py314m/Scripts/python.exe" \
                "$(command -v python3.15t 2>/dev/null)" \
                "$(command -v python3 2>/dev/null)"; do
        [ -n "$cand" ] && [ -x "$cand" ] && { PY="$cand"; break; }
    done
fi

# ─── Check 0: disk floor ───
# Runs BEFORE anything else because a full disk does not fail as "disk full":
# measured 2026-11-02 on this box (5.0 GB free, 100% used) the symptoms were a
# locked SQLite database, a corrupt git object and a truncated PNG. Every check
# below writes something -- a temp snapshot, an evidence file -- and a write that
# truncates produces a gate whose verdict is about a half file.
# Threshold: preflight.disk_floor_gb in config/defaults.json (10.0).
echo "[Disk] Checking free space against the floor..."
if [ -f "$SCRIPT_DIR/tools/disk_floor_gate.py" ]; then
    DISK_OUT=$("$PY" "$SCRIPT_DIR/tools/disk_floor_gate.py" 2>&1)
    DISK_EXIT=$?
    echo "$DISK_OUT" | tail -12
    if [ $DISK_EXIT -ne 0 ]; then
        echo ""
        echo "[Disk] Refusing to work on a volume below the floor (exit $DISK_EXIT)."
        exit 1
    fi
else
    echo "[Disk] gate not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 1: bulk-diff focus gate ───
# Runs FIRST, on every commit, because the scanner below skips when no .py
# files are staged -- and bulk dirt is usually docs/data, not code. Focused
# commits pass; deliberate bulk ops declare ALLOW_BULK_COMMIT=1.
echo "[Gate] Checking changeset focus..."
if [ -x "$PYTHON3" ]; then
    "$PYTHON3" scripts/commit_gate.py --hook 2>&1
    if [ $? -ne 0 ]; then
        echo ""
        echo "[Gate] Bulk changeset blocked (see above)."
        exit 1
    fi
    echo "[Gate] Changeset is focused."
else
    echo "[Gate] 3.15t python not found -- passing loud (gate unrunnable)"
fi
echo ""

# ─── Check 1b: stale-index guard ───
# Runs BEFORE the scanner, because the scanner reads the INDEX
# (`git show :0:<path>`): with a stale index it certifies a version nobody has
# on disk -- and that version is what would be COMMITTED. Measured 2026-10-11:
# a commit rejected by the scanner was then corrected in the worktree and
# re-committed without `git add`, so HEAD recorded the opposite of the truth.
# The tell was a staged diff of 68 insertions(+) and 0 DELETIONS for an edit
# that removed words -- a shape nobody reads at the moment it happens.
echo "[IndexDrift] Checking that every staged path matches the worktree..."
if [ -f "$SCRIPT_DIR/tools/index_drift_check.py" ]; then
    # Capture first, then print: `cmd | tail` would make $? tail's status, not
    # the check's, and a gate that reads the wrong exit code is worse than none.
    DRIFT_OUT=$("$PY" "$SCRIPT_DIR/tools/index_drift_check.py" 2>&1)
    DRIFT_EXIT=$?
    echo "$DRIFT_OUT" | tail -12
    if [ $DRIFT_EXIT -ne 0 ]; then
        echo ""
        echo "[IndexDrift] A staged path has unstaged edits: the commit would"
        echo "[IndexDrift] carry the version from before that edit."
        echo "[IndexDrift] Fix: git add <path>   (or declare ALLOW_STALE_INDEX=1)"
        exit 1
    fi
else
    echo "[IndexDrift] guard not found -- passing loud (guard unrunnable)"
fi
echo ""

# ─── Check 2: compliance scanner on the staged .py snapshot ───
# Diffs each staged .py file against its HEAD version and fails only on a
# per-category INCREASE. The old form wrote a temp snapshot and failed on ANY
# finding at --severity warning, so every legacy file (837 silent_except_pass
# in the baseline) was uncommittable -- a gate that can never pass is the same
# defect class as one that can never fail.
echo "[Scanner] Checking staged .py files for NEW anti-patterns..."
if [ -f "$SCRIPT_DIR/tools/staged_scanner_gate.py" ]; then
    PYTHONPATH="src:${PYTHONPATH:-}" "$PY" "$SCRIPT_DIR/tools/staged_scanner_gate.py" 2>&1
    SCAN_EXIT=$?
    if [ $SCAN_EXIT -ne 0 ]; then
        echo ""
        echo "[Scanner] New anti-pattern(s) in staged .py files."
        exit 1
    fi
else
    echo "[Scanner] gate not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 3: canon drift (source corpus vs load path) ───
# `skills/` is the source corpus (RULE 0R); `.agents/skills/<n>/SKILL.md` is
# what `skill()` loads. Nothing checked that sync happened, and 44 skills had
# drifted -- 26 with the load-path copy missing its YAML frontmatter entirely.
echo "[Canon] Checking skill corpus against the load path..."
if [ -f "$SCRIPT_DIR/tools/canon_drift_check.py" ]; then
    # Capture first, then print: `cmd | tail` would make $? tail's status, not
    # the check's, and a gate that reads the wrong exit code is worse than none.
    CANON_OUT=$("$PY" "$SCRIPT_DIR/tools/canon_drift_check.py" --check 2>&1)
    CANON_EXIT=$?
    echo "$CANON_OUT" | tail -12
    if [ $CANON_EXIT -ne 0 ]; then
        echo ""
        echo "[Canon] Skill drift between skills/ and .agents/skills/."
        echo "[Canon] Reconcile: python tools/canon_drift_check.py --fix"
        exit 1
    fi
else
    echo "[Canon] check not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 7b (blocking): testing-paradigm G1 (Engram #890 item 4) ───
# Every NEW staged src/ module must be named by at least one tests/ file.
# Narrow by design (Added-only, name-presence only) so it cannot
# false-positive on the existing tree; measured green on wiring day
# (modules=0 on the landing index). Blocking from birth: an advisory
# presence gate that never blocks is the #889 drift shape (mechanized
# but not enforced). Bypass only by naming the module in a test.
if [ -f "$SCRIPT_DIR/tools/test_paradigm_gate.py" ]; then
    if [ -x "$PYTHON3" ]; then
        "$PYTHON3" "$SCRIPT_DIR/tools/test_paradigm_gate.py" 2>&1
        if [ $? -ne 0 ]; then
            echo ""
            echo "[Paradigm] BLOCKED (G1). Name the new src/ module in a tests/ file."
            exit 1
        fi
    else
        echo "[Paradigm] 3.15t python not found -- passing loud (gate unrunnable)"
    fi
fi

# ─── Check: heredoc-pipe lint (advisory, shell files) ───
if [ -f "$SCRIPT_DIR/tools/heredoc_pipe_lint.py" ]; then
    staged_sh=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.(sh|bash)$' || true)
    if [ -n "$staged_sh" ]; then
        if [ -x "$PYTHON3" ]; then
            echo "$staged_sh" | xargs "$PYTHON3" "$SCRIPT_DIR/tools/heredoc_pipe_lint.py" >/dev/null 2>&1
            if [ $? -ne 0 ]; then
                echo "[HeredocLint] advisory: unsafe heredoc detected in staged shell file(s)"
            fi
        fi
    fi
fi

# ─── Check 8 (blocking): unified supervisor verdict ───
# The supervisor MCP merges the Engram gate with PMB liveness and honest PAMS
# probes. A commit on NO-GO would record a tree the memories say is broken,
# so this refuses -- but ONLY on a parsed NO-GO (positive evidence). GO and
# CLARIFY pass; an unrunnable/unparseable oracle passes loud (a gate that
# blocks when it cannot measure is a denial-of-service on every commit).
# Deliberate override, declared not silent: ALLOW_SUPERVISOR_NOGO=1.
# Remediation pointer, not just refusal: tools/supervisor_doctor.py --fix.
if [ "${ALLOW_SUPERVISOR_NOGO:-}" = "1" ]; then
    echo "[Supervisor] NO-GO override declared via ALLOW_SUPERVISOR_NOGO=1."
    echo ""
fi
if [ "${ALLOW_SUPERVISOR_NOGO:-}" != "1" ] && [ -f "$SCRIPT_DIR/tools/supervisor_mcp.py" ]; then
    echo "[Supervisor] Checking unified verdict..."
    if [ -x "$PYTHON3" ]; then
        SUP_OUT=$("$PYTHON3" "$SCRIPT_DIR/tools/supervisor_mcp.py" --verdict 2>&1)
        SUP_EXIT=$?
        echo "$SUP_OUT" | tail -10
        SUP_VERDICT=$(echo "$SUP_OUT" | grep "^VERDICT:" | tail -1)
        case "$SUP_VERDICT" in
            *NO-GO*)
                echo ""
                echo "[Supervisor] BLOCKED: memories report NO-GO (see above)."
                echo "[Supervisor] Remediate: judge pending pairs, record outcomes,"
                echo "[Supervisor]   then: python tools/supervisor_doctor.py --fix"
                echo "[Supervisor] Override (declared): ALLOW_SUPERVISOR_NOGO=1."
                exit 1
                ;;
            *)
                if [ -z "$SUP_VERDICT" ]; then
                    echo "[Supervisor] verdict unparseable (exit=$SUP_EXIT) -- passing loud."
                fi
                ;;
        esac
    else
        echo "[Supervisor] 3.15t python not found -- passing loud (gate unrunnable)"
    fi
    echo ""
fi

# ─── Check 10 (blocking): generated instruction blocks vs their source ───
# The MCP gate standing order, the FLOCK canon and the META-LEVELS canon are
# single-sourced in `docs/agent_orders/*.md` and GENERATED into nine instruction
# files (home `AGENTS.md`, `C:/Azazael/AGENTS.md`, and the kilo / opencode /
# claude lane files). Until 2026-10-30 those blocks had four hand-maintained
# copies; the gate they described was rewritten the same day and every copy was
# stale within hours, so each session opened on instructions describing a check
# that no longer existed. A commit is where the source changes, so a commit is
# where the copies must still match it.
# Runs on EVERY commit, including commits that touch no rule file: the targets
# live OUTSIDE the repo, so a staged-path filter could never see the drift this
# check exists to stop.
# Declared override, never silent: ALLOW_AGENT_ORDERS_DRIFT=1.
if [ "${ALLOW_AGENT_ORDERS_DRIFT:-}" = "1" ]; then
    echo "[AgentOrders] skipped: ALLOW_AGENT_ORDERS_DRIFT=1 declared."
    echo ""
fi
if [ "${ALLOW_AGENT_ORDERS_DRIFT:-}" != "1" ] && [ -f "$SCRIPT_DIR/tools/agent_orders_sync.py" ]; then
    echo "[AgentOrders] Checking generated instruction blocks against their source..."
    # Status captured immediately, output printed after. `cmd | tail` makes $?
    # tail's status, not the check's -- a false pass this repo has produced
    # three times.
    #           --hook: compare only the targets that EXIST on this host, print
    #           the ones that do not, and fail if none exist at all. The nine
    #           targets are host-absolute lane files, so a Kali lane or a fresh
    #           clone would otherwise block every commit over files it cannot
    #           see -- a gate that cannot run here is worse than no gate.
    #           --wsl: the Ubuntu and Kali lanes read their orders from the
    #           Linux tree, and on 2026-10-31 NEITHER carried a single block
    #           (Ubuntu /root/AGENTS.md 2003 bytes / 0 blocks; Kali
    #           /root/BCC-REINVESTIGATION/AGENTS.md 14783 / 0). Those blocks are
    #           host-rewritten (python -> python3, C:/ -> /mnt/c), so they can
    #           never be checked by looking at Windows files. A host without wsl
    #           says so and passes; a present distro that drifts blocks.
    #           3.6 s measured, so it rides along instead of being a separate gate.
    ORDERS_OUT=$("$PY" "$SCRIPT_DIR/tools/agent_orders_sync.py" --hook --wsl 2>&1)
    ORDERS_EXIT=$?
    echo "$ORDERS_OUT"
    if [ $ORDERS_EXIT -ne 0 ]; then
        echo ""
        echo "[AgentOrders] BLOCKED: a generated block differs from azazael/docs/agent_orders/."
        echo "[AgentOrders] Fix: $PY $SCRIPT_DIR/tools/agent_orders_sync.py --apply --wsl"
        echo "[AgentOrders] Copies are never hand-edited -- edit the source, then regenerate."
        echo "[AgentOrders] Override (declared): ALLOW_AGENT_ORDERS_DRIFT=1."
        exit 1
    fi
    echo ""
fi

# ─── Check 10b (blocking): instruction-file prose (tools/prompt_check.py) ───
# Check 10 above proves every GENERATED block matches its source. It says nothing
# about the prose between the blocks, and that prose is what a fresh session reads
# first: measured 2026-11-02, the seven lane prompts claimed 5,380 tests against a
# live collection of 6,277, cited six paths that no longer existed, and carried a
# hand-copied RENDER section that lived in no source at all -- so it could rot with
# nothing able to notice. Every number in this hook's own tree is falsifiable; the
# instruction files were the last place where a claim cost nothing to make.
# Cost: seven file reads plus stat calls, no subprocesses. Runs on EVERY commit for
# the same reason check 10 does -- the targets live outside the repo.
# Exit 2 means the instrument could not run (no lane prompt on this host); that is
# reported loud and allowed, exactly as check 10 treats a host with no targets.
# Declared override, never silent: ALLOW_PROMPT_STALE=1.
if [ "${ALLOW_PROMPT_STALE:-}" = "1" ]; then
    echo "[Prompt] skipped: ALLOW_PROMPT_STALE=1 declared."
    echo ""
fi
if [ "${ALLOW_PROMPT_STALE:-}" != "1" ] && [ -f "$SCRIPT_DIR/tools/prompt_check.py" ]; then
    echo "[Prompt] Checking instruction-file claims (paths, counts, handoff SHA)..."
    PROMPT_OUT=$("$PY" "$SCRIPT_DIR/tools/prompt_check.py" 2>&1)
    PROMPT_EXIT=$?
    echo "$PROMPT_OUT"
    if [ $PROMPT_EXIT -eq 2 ]; then
        echo "[Prompt] gate unrunnable on this host (no lane prompt found) -- passing loud."
    elif [ $PROMPT_EXIT -ne 0 ]; then
        echo ""
        echo "[Prompt] BLOCKED: an instruction file carries a claim that does not resolve."
        echo "[Prompt] Fix: the DEFECT line names the file and the line number. A count"
        echo "[Prompt] that moved: correct it, or mark the sentence 'historical' if it is a"
        echo "[Prompt] past reading quoted for its lesson. A dead path: repoint it or delete it."
        echo "[Prompt] Override (declared): ALLOW_PROMPT_STALE=1."
        exit 1
    fi
    echo ""
fi

# NOTE: the RULE 0B-E commit-message claim guard lives in
# .githooks/prepare-commit-msg, NOT here. It was first written into this file
# and MEASURED BROKEN: `git commit -m` writes .git/COMMIT_EDITMSG *after*
# pre-commit runs, so the check read a stale file, passed, and an overclaiming
# message ("this is done, nothing was modified, this passes") landed as
# 94970d9e before the fault was found. prepare-commit-msg receives the message
# file as $1 and runs BEFORE this hook, so it sees the real text. A guard that
# reads the wrong file is worse than no guard -- it manufactures false
# confidence, which is the exact defect class RULE 0B-E exists to stop.

# ─── Check 6 (non-blocking): PMB outcome observer ───
# A commit is an outcome-bearing turn. Recording it here feeds PMB's
# Earned-Memory loop (`lesson_impact`) and its adherence pass, both of which
# read the `agent_actions` table. That table is written on this host by
# tools/pmb_session_observe.py, wired at the two triggers that ALWAYS fire --
# the test run (conftest.py) and this commit. Deliberately NON-blocking: a
# memory side-effect must never reject a commit, so its exit code is ignored.
if [ -f "$SCRIPT_DIR/tools/pmb_session_observe.py" ]; then
    PMB_PY="${PMB_VENV_PYTHON:-$HOME/.pmb-venv/Scripts/python.exe}"
    if [ -x "$PMB_PY" ]; then
        "$PMB_PY" "$SCRIPT_DIR/tools/pmb_session_observe.py" --commit-ok --quiet 2>/dev/null || true
    fi
fi


# ─── Tier notice: what this commit did NOT run, and when it will ───
# Printed on every commit. A deferred check nobody can see is indistinguishable
# from a deleted one, so the list is named and paired with the command that runs
# it -- and the last evidence reading is quoted, not remembered.
if [ "${COMMIT_TIER:-fast}" = "full" ]; then
    echo "[Tier] COMMIT_TIER=full declared: running the evidence tier inline."
    TIER_T0=$(date +%s)
    sh "$SCRIPT_DIR/tools/evidence_tier.sh"
    EV_RC=$?
    echo "[Tier] evidence tier exit=$EV_RC wall=$(( $(date +%s) - TIER_T0 ))s"
    if [ $EV_RC -ne 0 ]; then
        echo ""
        echo "[Tier] BLOCKED: the evidence tier refused this tree (see above)."
        exit 1
    fi
else
    echo "[Tier] evidence tier deferred to pre-push: canon corpora, platform"
    echo "[Tier] claims, anti-pattern + unresolved-reference ratchets, mesh/wire/"
    echo "[Tier] evidence ledgers, span-receipt selftest, METTHEW catalogue,"
    echo "[Tier] at-risk register, paradigm rule 1, gate registry, AP-5 scan."
    echo "[Tier] Run it now: sh tools/evidence_tier.sh   (or COMMIT_TIER=full)"
    if [ -f "$SCRIPT_DIR/logs/hook_evidence.json" ]; then
        echo "[Tier] last evidence run: $(cat "$SCRIPT_DIR/logs/hook_evidence.json")"
    else
        echo "[Tier] last evidence run: NEVER recorded on this host."
    fi
    echo ""
fi

exit 0
