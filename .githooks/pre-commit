#!/bin/sh
# Pre-commit hook: compliance scanner + anti-pattern ratchet on staged .py files
# Installed by: python tools/install_git_hooks.py  (sets core.hooksPath=.githooks)
#
# Check order (cheap-and-broad first, so a bad commit is rejected early):
#   1. bulk-diff focus gate      (scripts/commit_gate.py)
#   1b. stale-index guard        (tools/index_drift_check.py) -- a path staged
#       and then edited again would be committed as the STALE blob, and the
#       scanner below reads the INDEX, so it would certify a version that is
#       not on disk at all
#   2. staged NEW anti-pattern  (tools/staged_scanner_gate.py, per-file vs HEAD)
#   3. canon drift check         (tools/canon_drift_check.py --check)
#   4. repo-wide anti-pattern ratchet (tools/anti_pattern_gate.py --check)
#
# Why check 3 exists even though check 2 already scans: check 2 is PER-FILE
# (staged vs HEAD), so it catches an anti-pattern being ADDED but cannot see
# the running total. The ratchet compares the whole
# `src/` tree against logs/anti_pattern_baseline.json and fails on any
# category INCREASE, which is what keeps the 2,224-finding backlog from
# growing while it is paid down (reports/ERROR_LESSON_AUDIT_2026-10-03.md,
# gap 1: "MECHANIZED BUT NOT ENFORCED").
#
# Check 3 runs on EVERY commit, including commits with no staged .py files:
# check 2 skips in that case, and it is exactly the docs/data commit that
# could still have grown the tree. A check that is skipped when it is
# inconvenient is the defect this hook exists to stop.

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR" || exit 1

# ─── Check 1: bulk-diff focus gate ───
# Runs FIRST, on every commit, because the scanner below skips when no .py
# files are staged -- and bulk dirt is usually docs/data, not code. Focused
# commits pass; deliberate bulk ops declare ALLOW_BULK_COMMIT=1.
echo "[Gate] Checking changeset focus..."
if command -v python3 >/dev/null 2>&1; then
    python3 scripts/commit_gate.py --hook 2>&1
    if [ $? -ne 0 ]; then
        echo ""
        echo "[Gate] Bulk changeset blocked (see above)."
        exit 1
    fi
    echo "[Gate] Changeset is focused."
else
    echo "[Gate] python3 not found -- passing loud (gate unrunnable)"
fi
echo ""

# ─── Check 1b: stale-index guard ───
# Runs BEFORE the scanner, because the scanner reads the INDEX
# (`git show :0:<path>`): with a stale index it certifies a version nobody has
# on disk -- and that version is what would be COMMITTED. Measured 2026-10-11:
# a commit rejected by the scanner was then corrected in the worktree and
# re-committed without `git add`, so HEAD recorded the opposite of the truth.
# The tell was a staged diff of 68 insertions(+) and 0 DELETIONS for an edit
# that removed words -- a shape nobody reads at the moment it happens.
echo "[IndexDrift] Checking that every staged path matches the worktree..."
if [ -f "$SCRIPT_DIR/tools/index_drift_check.py" ]; then
    # Capture first, then print: `cmd | tail` would make $? tail's status, not
    # the check's, and a gate that reads the wrong exit code is worse than none.
    DRIFT_OUT=$(python "$SCRIPT_DIR/tools/index_drift_check.py" 2>&1)
    DRIFT_EXIT=$?
    echo "$DRIFT_OUT" | tail -12
    if [ $DRIFT_EXIT -ne 0 ]; then
        echo ""
        echo "[IndexDrift] A staged path has unstaged edits: the commit would"
        echo "[IndexDrift] carry the version from before that edit."
        echo "[IndexDrift] Fix: git add <path>   (or declare ALLOW_STALE_INDEX=1)"
        exit 1
    fi
else
    echo "[IndexDrift] guard not found -- passing loud (guard unrunnable)"
fi
echo ""

# ─── Check 2: compliance scanner on the staged .py snapshot ───
# Diffs each staged .py file against its HEAD version and fails only on a
# per-category INCREASE. The old form wrote a temp snapshot and failed on ANY
# finding at --severity warning, so every legacy file (837 silent_except_pass
# in the baseline) was uncommittable -- a gate that can never pass is the same
# defect class as one that can never fail.
echo "[Scanner] Checking staged .py files for NEW anti-patterns..."
if [ -f "$SCRIPT_DIR/tools/staged_scanner_gate.py" ]; then
    PYTHONPATH="src:${PYTHONPATH:-}" python "$SCRIPT_DIR/tools/staged_scanner_gate.py" 2>&1
    SCAN_EXIT=$?
    if [ $SCAN_EXIT -ne 0 ]; then
        echo ""
        echo "[Scanner] New anti-pattern(s) in staged .py files."
        exit 1
    fi
else
    echo "[Scanner] gate not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 3: canon drift (source corpus vs load path) ───
# `skills/` is the source corpus (RULE 0R); `.agents/skills/<n>/SKILL.md` is
# what `skill()` loads. Nothing checked that sync happened, and 44 skills had
# drifted -- 26 with the load-path copy missing its YAML frontmatter entirely.
echo "[Canon] Checking skill corpus against the load path..."
if [ -f "$SCRIPT_DIR/tools/canon_drift_check.py" ]; then
    # Capture first, then print: `cmd | tail` would make $? tail's status, not
    # the check's, and a gate that reads the wrong exit code is worse than none.
    CANON_OUT=$(python "$SCRIPT_DIR/tools/canon_drift_check.py" --check 2>&1)
    CANON_EXIT=$?
    echo "$CANON_OUT" | tail -12
    if [ $CANON_EXIT -ne 0 ]; then
        echo ""
        echo "[Canon] Skill drift between skills/ and .agents/skills/."
        echo "[Canon] Reconcile: python tools/canon_drift_check.py --fix"
        exit 1
    fi
else
    echo "[Canon] check not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 4: repo-wide anti-pattern ratchet ───
# Fails on any category COUNT increase over the recorded baseline. This is
# deliberately repo-wide and runs unconditionally: the scanner snapshot in
# check 2 cannot see the running total, and the backlog is what is ratcheted.
echo "[Ratchet] Comparing anti-pattern counts against baseline..."
if [ -f "$SCRIPT_DIR/tools/anti_pattern_gate.py" ]; then
    PYTHONPATH="src:${PYTHONPATH:-}" python "$SCRIPT_DIR/tools/anti_pattern_gate.py" --check 2>&1
    RATCHET_EXIT=$?
    if [ $RATCHET_EXIT -ne 0 ]; then
        echo ""
        echo "[Ratchet] Anti-pattern count INCREASED over baseline. Fix the new"
        echo "[Ratchet] finding(s), or -- for a reviewed, deliberate increase --"
        echo "[Ratchet] re-run: python tools/anti_pattern_gate.py --baseline"
        exit 1
    fi
else
    echo "[Ratchet] gate not found -- passing loud (gate unrunnable)"
fi
echo ""

# ─── Check 5: mesh wire-or-cut ledger freshness ───
# NEURAL_MESH_WIRE_OR_CUT.json is GENERATED, and nothing regenerated it when
# a caller changed -- so it went stale silently. Measured 2026-10-10: the
# restored EP235 loop made read_pressure statically called while the ledger
# still said `dispatched`, and tests/test_mesh_wire_or_cut.py failed on state
# the code had already moved past. Fails when the set of unreferenced
# functions no longer matches the committed ledger.
echo "[Mesh] Checking wire-or-cut ledger freshness..."
if [ -f "$SCRIPT_DIR/tools/mesh_function_preflight.py" ]; then
    # Capture first, then print: piping into tail would make $? tail's
    # status and this gate would read the wrong exit code.
    MESH_OUT=$(PYTHONPATH="src:${PYTHONPATH:-}" python "$SCRIPT_DIR/tools/mesh_function_preflight.py" --check 2>&1)
    MESH_EXIT=$?
    echo "$MESH_OUT" | tail -12
    if [ $MESH_EXIT -ne 0 ]; then
        echo ""
        echo "[Mesh] Ledger is STALE against the code. Refresh:"
        echo "[Mesh]   python tools/mesh_function_preflight.py --verdict --triage"
        exit 1
    fi
else
    echo "[Mesh] check not found -- passing loud (check unrunnable)"
fi
echo ""

# ─── Check 6 (non-blocking): PMB outcome observer ───
# A commit is an outcome-bearing turn. Recording it here feeds PMB's
# Earned-Memory loop (`lesson_impact`) and its adherence pass, both of which
# read the `agent_actions` table. That table is written on this host by
# tools/pmb_session_observe.py, wired at the two triggers that ALWAYS fire --
# the test run (conftest.py) and this commit. Deliberately NON-blocking: a
# memory side-effect must never reject a commit, so its exit code is ignored.
if [ -f "$SCRIPT_DIR/tools/pmb_session_observe.py" ]; then
    PMB_PY="${PMB_VENV_PYTHON:-$HOME/.pmb-venv/Scripts/python.exe}"
    if [ -x "$PMB_PY" ]; then
        "$PMB_PY" "$SCRIPT_DIR/tools/pmb_session_observe.py" --commit-ok --quiet 2>/dev/null || true
    fi
fi

exit 0
