 {
  "title": "1,042 package skills stay archived and indexed",
  "suite": "regression",
  "cmd": [
   "{python}",
   "-c",
   "import json,pathlib;live=list(pathlib.Path('skills').glob('azazael-pkg*.md'));arch=list(pathlib.Path('skills.pkg-archive/source').glob('azazael-pkg*.md'));idx=json.loads(pathlib.Path('tools/data/pkg_index.json').read_text(encoding='utf-8'));print(f'live={len(live)} archived={len(arch)} indexed={idx[\"count\"]}');raise SystemExit(0 if (len(live)==0 and len(arch)==1042 and idx['count']==1042) else 1)"
  ],
  "expect": {
   "exit_code": 0,
   "stdout_contains": [
    "live=0 archived=1042 indexed=1042"
   ],
   "timeout_s": 60
  },
  "id": "pkg-skills-archived"
 },
 {
